{
  "version": 2,
  "framework": null,
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.3"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(build/.*|images/.*|css/.*|js/.*|vendor/.*|storage/.*|favicon.*|robots.txt|.*\\.(?:ico|png|jpg|jpeg|gif|svg|css|js|webp|woff|woff2|ttf|eot|map))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "ISMY Yogyakarta",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_KEY": "base64:DfqxP4pZlkL/m85AABaZMgC0K6AVKAMnA9TtRq4lFfc=",
    "APP_URL": "https://ismy-web.vercel.app",
    "APP_MAINTENANCE_DRIVER": "file",
    "APP_CONFIG_CACHE": "/tmp/storage/framework/cache/config.php",
    "APP_EVENTS_CACHE": "/tmp/storage/framework/cache/events.php",
    "APP_PACKAGES_CACHE": "/tmp/storage/framework/cache/packages.php",
    "APP_ROUTES_CACHE": "/tmp/storage/framework/cache/routes.php",
    "APP_SERVICES_CACHE": "/tmp/storage/framework/cache/services.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "CACHE_STORE": "array",
    "SESSION_DRIVER": "cookie",
    "SESSION_LIFETIME": "120",
    "BCRYPT_ROUNDS": "10",
    "LOG_CHANNEL": "stderr"
  }
}
